    "check:dynamic-geocoding": "node scripts/check-dynamic-geocoding.mjs",
    "check:operational-analysis": "node scripts/check-operational-analysis.mjs",
    "check:gradium-assets": "node scripts/check-gradium-assets.mjs",
    "generate:gradium-audio": "node --env-file=.env scripts/generate-scenario-audio.mjs",
    "prepare:map-worker": "node scripts/prepare-maplibre-worker.mjs",
    "lint": "oxlint app components/flood-dashboard.tsx components/response-actions.tsx components/vinh-map.tsx hooks/use-assemblyai-stream.ts hooks/use-gradium-tts.ts lib/gradium.ts lib/incidents.ts lib/server-env.ts public/pcm-processor.js",
